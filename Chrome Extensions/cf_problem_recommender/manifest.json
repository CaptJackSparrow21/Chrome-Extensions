{
  "manifest_version": 3,
  "name": "CF Problem Recommender",
  "version": "2.5.0",
  "description": "Find five popular Codeforces problems you have not solved yet.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://codeforces.com/api/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CF Problem Recommender",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/profile/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "https://codeforces.com/*"
      ]
    }
  ]
}
